# Local Mock AI fixture regression; model quality is not evaluated.
connection default;
--disable_query_log
--disable_result_log
set names utf8mb4;
set ob_query_timeout=60000000;
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('reg_ai_complete');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('reg_ai_complete_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('reg_ai_complete','{"type":"completion","model_name":"completion-any"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('reg_ai_complete_ep','{"ai_model_name":"reg_ai_complete","scope":"all","url":"http://0.0.0.0:8000/v1/chat/completions","access_key":"mock-key","provider":"openai"}');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('reg_ai_embed');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('reg_ai_embed_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('reg_ai_embed','{"type":"dense_embedding","model_name":"embed-any"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('reg_ai_embed_ep','{"ai_model_name":"reg_ai_embed","scope":"all","url":"http://0.0.0.0:8000/v1/embeddings?fault=reverse","access_key":"mock-key","provider":"openai"}');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('reg_ai_rerank');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('reg_ai_rerank_ep');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('reg_ai_rerank','{"type":"rerank","model_name":"rerank-any"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('reg_ai_rerank_ep','{"ai_model_name":"reg_ai_rerank","scope":"all","url":"http://0.0.0.0:8000/v1/rerank?fault=reverse","access_key":"mock-key","provider":"siliconflow"}');
drop table if exists reg_ai_rows;
create table reg_ai_rows(id int primary key, content text, expected decimal(10,6));
