--enable_result_log
--echo invalid input and response checks passed
--echo ordinary SQL still works after AI errors
select count(*) as row_count from reg_ai_rows;
--disable_result_log
drop table reg_ai_rows;
call DBMS_AI_SERVICE.DROP_AI_MODEL('reg_ai_complete');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('reg_ai_complete_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('reg_ai_embed');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('reg_ai_embed_ep');
