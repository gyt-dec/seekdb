select ai_embed('reg_ai_embed','text',0);
--error 1210
select ai_embed('reg_ai_embed','text',2.5);
--error 1210
select ai_complete('reg_ai_complete',ai_prompt('{99}','x'));
--error 1210
select ai_complete('reg_ai_complete','hello','[]');
--error 1210
select ai_complete('reg_ai_complete','hello',json_object('max_tokens',0));
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('reg_ai_embed_ep','{"url":"http://0.0.0.0:8000/v1/embeddings?fault=wrong_dimension"}');
--error 1210
select ai_embed('reg_ai_embed','text',4);
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('reg_ai_embed_ep','{"url":"http://0.0.0.0:8000/v1/embeddings?fault=missing_index"}');
--error 4070
select ai_embed('reg_ai_embed','text',4);
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('reg_ai_embed_ep','{"url":"http://0.0.0.0:8000/v1/embeddings?fault=bad_number"}');
--error 4070
select ai_embed('reg_ai_embed','text',4);
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('reg_ai_embed_ep','{"url":"http://0.0.0.0:8000/v1/embeddings?fault=non_object"}');
--error 4070
select ai_embed('reg_ai_embed','text',4);
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('reg_ai_embed_ep','{"url":"http://0.0.0.0:8000/v1/embeddings?fault=invalid_json"}');
--error 3140
select ai_embed('reg_ai_embed','text',4);
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('reg_ai_complete_ep','{"url":"http://0.0.0.0:8000/v1/chat/completions?fault=empty_completion"}');
