--enable_result_log
--echo repeated long Prompt
select ai_complete('reg_ai_complete',ai_prompt('{0}/{0}',repeat('x',10000)),null)=concat('mock: ',repeat('x',10000),'/',repeat('x',10000)) as ok;
--echo Unicode and literal braces
select ai_complete('reg_ai_complete',ai_prompt('{{{0}}}','世界'))='mock: {世界}' as ok;
--echo nested JSON Prompt
select ai_complete('reg_ai_complete',ai_prompt('outer[{0}]',ai_prompt('inner {0}',json_object('k','世界')))) like 'mock: outer[inner %世界%]' as ok;
--echo native JSON generation config
select ai_complete('reg_ai_complete','hello',json_object('temperature',0.2,'max_tokens',16))='mock: hello' as ok;
--echo reversed Embedding batches preserve row identity and NULL
select count(*) as row_count, sum(if(content is null,embedding is null,json_length(embedding)=4 and abs(cast(json_extract(embedding,'$[0]') as decimal(10,6))-expected)<0.000001)) as matching_rows from (select id,content,expected,ai_embed('reg_ai_embed',content,4) as embedding from reg_ai_rows) x;
--echo filtered Embedding batches
select count(*) as row_count, sum(if(content is null,embedding is null,json_length(embedding)=4 and abs(cast(json_extract(embedding,'$[0]') as decimal(10,6))-expected)<0.000001)) as matching_rows from (select id,content,expected,ai_embed('reg_ai_embed',content,4) as embedding from reg_ai_rows where id between 60 and 75) x;
--echo Embedding LIMIT preserves ordered rows
select id,json_length(ai_embed('reg_ai_embed',content,4)) as dimension from reg_ai_rows where id>=60 order by id limit 5;
--echo scalar NULL does not call the model
select ai_embed('reg_ai_embed',null,4) is null as ok;
--echo Rerank across three batches restores global indices
select json_extract(r,'$[0].index')=41 and json_length(r)=42 as ok from (select ai_rerank('reg_ai_rerank','needle','["hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","needle"]',null) as r) x;
--echo Rerank ties use original input order
select json_extract(r,'$[0].index')=0 and json_extract(r,'$[20].index')=20 and json_extract(r,'$[41].index')=41 as ok from (select ai_rerank('reg_ai_rerank','absent','["hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","hay","needle"]',null) as r) x;
--echo Rerank objects retain original IDs across batches
select json_unquote(json_extract(r,'$[0].id'))='doc-41' and json_length(r)=42 as ok from (select ai_rerank('reg_ai_rerank','needle','[{"id":"doc-0","text":"hay"},{"id":"doc-1","text":"hay"},{"id":"doc-2","text":"hay"},{"id":"doc-3","text":"hay"},{"id":"doc-4","text":"hay"},{"id":"doc-5","text":"hay"},{"id":"doc-6","text":"hay"},{"id":"doc-7","text":"hay"},{"id":"doc-8","text":"hay"},{"id":"doc-9","text":"hay"},{"id":"doc-10","text":"hay"},{"id":"doc-11","text":"hay"},{"id":"doc-12","text":"hay"},{"id":"doc-13","text":"hay"},{"id":"doc-14","text":"hay"},{"id":"doc-15","text":"hay"},{"id":"doc-16","text":"hay"},{"id":"doc-17","text":"hay"},{"id":"doc-18","text":"hay"},{"id":"doc-19","text":"hay"},{"id":"doc-20","text":"hay"},{"id":"doc-21","text":"hay"},{"id":"doc-22","text":"hay"},{"id":"doc-23","text":"hay"},{"id":"doc-24","text":"hay"},{"id":"doc-25","text":"hay"},{"id":"doc-26","text":"hay"},{"id":"doc-27","text":"hay"},{"id":"doc-28","text":"hay"},{"id":"doc-29","text":"hay"},{"id":"doc-30","text":"hay"},{"id":"doc-31","text":"hay"},{"id":"doc-32","text":"hay"},{"id":"doc-33","text":"hay"},{"id":"doc-34","text":"hay"},{"id":"doc-35","text":"hay"},{"id":"doc-36","text":"hay"},{"id":"doc-37","text":"hay"},{"id":"doc-38","text":"hay"},{"id":"doc-39","text":"hay"},{"id":"doc-40","text":"hay"},{"id":"doc-41","text":"needle"}]','text') as r) x;
